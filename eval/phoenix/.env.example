# Nonsecret role selections. Existing caller supplies credentials at runtime.
# IRS MCP server requires no model credentials.
AGENT_MODEL=
JUDGE_MODEL=
AGENT_PROVIDER=openai-compatible
JUDGE_PROVIDER=openai-compatible
# Optional role endpoints override caller's existing OPENAI_BASE_URL binding.
AGENT_BASE_URL=
JUDGE_BASE_URL=
# Role credentials may use AGENT_API_KEY / JUDGE_API_KEY, with existing
# OPENAI_API_KEY binding as fallback. Keep values outside source and traces.

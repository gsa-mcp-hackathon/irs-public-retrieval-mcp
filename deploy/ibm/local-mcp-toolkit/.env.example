# watsonx Orchestrate connection for the LOCAL MCP toolkit (stdio).
#
# Copy to .env and fill in, then:
#   set -a; source deploy/ibm/local-mcp-toolkit/.env; set +a
# Nonsecret instance coordinates, environment/toolkit names, auth type, and optional interpreter selection belong here. Pass API keys at runtime (see README).

# Name to give the Orchestrate ADK environment (arbitrary, local label).
WXO_ENV_NAME=gsa-hackathon

# For default ibm_iam, find intended Orchestrate instance URL on IBM Cloud service page (Resource List -> intended wxO instance).
# Example:
#   WXO_INSTANCE_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/<id>
WXO_INSTANCE_URL=

# Auth type must match installed ADK enum exactly. Default targets IBM Cloud IAM.
# Other supported types can need additional target-specific authentication.
WXO_ENV_TYPE=ibm_iam

# Optional Python containing installed ADK for exact environment-identity checks.
# Defaults to PYTHON, then python. Preparation-only runs do not import ADK.
# ADK_PYTHON=/path/to/adk-venv/bin/python

# Caller-selected registration name; generated YAML uses this value.
TOOLKIT_NAME=example_mcp_local

# Optional generated description; omit to retain template defaults.
TOOLKIT_DESCRIPTION="Retrieve public IRS manual passages with get_irm_passage, and locate forms, instructions, and publications with find_irs_products."

# --- API key (NOT stored here) -----------------------------------------------
# Provide your Orchestrate API key at runtime via WXO_API_KEY:
#   export WXO_API_KEY="<your key>"
# If unset, the register script prompts for it (input hidden).
